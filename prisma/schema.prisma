// Recovery metadata is tenant-independent and must survive merchant erasure.
// The singleton hold is present in every migrated database; only HELD rows
// block startup/transfer. Recovery fingerprints exclude these metadata tables.
model RecoveryHold {
  id                   String                   @id @default("1")
  state                String                   @default("HELD")
  reason               String                   @default("NONE")
  sourceManifestSha256 String?
  sourceArtifact       String?
  sourceArtifactSha256 String?
  restoredDbSha256     String?
  schemaSha256         String?
  replayEvidenceId     String?
  integrityTag         String                   @default("")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @default(now()) @updatedAt
  evidence             RecoveryReplayEvidence[]
  releaseAudits        RecoveryReleaseAudit[]

  @@map("_PagneticRecoveryHold")
}

model RecoveryReplayEvidence {
  id                       String                @id @default(cuid())
  holdId                   String
  evidenceVersion          Int                   @default(1)
  sourceManifestSha256     String
  sourceArtifact           String
  sourceArtifactSha256     String
  restoredDbSha256         String
  schemaSha256             String
  receiptInventoryDigest   String
  receiptInventoryStarted  DateTime
  receiptInventoryFinished DateTime
  retainedKeyFingerprints  String
  replayStartedAt          DateTime
  replayFinishedAt         DateTime
  receiptCount             Int
  unresolvedCount          Int
  erasureDigest            String
  postReplayDbSha256       String
  generatedAt              DateTime
  integrityTag             String
  hold                     RecoveryHold          @relation(fields: [holdId], references: [id], onDelete: Restrict)
  releaseAudit             RecoveryReleaseAudit?

  @@index([sourceManifestSha256, generatedAt])
}

model RecoveryReleaseAudit {
  id                         String                 @id @default(cuid())
  holdId                     String
  evidenceId                 String
  sourceManifestSha256       String
  sourceArtifactSha256       String
  restoredDbSha256           String
  schemaSha256               String
  receiptInventoryDigest     String
  evidenceHash               String
  operatorIdentity           String
  privacyReviewReference     String
  backupReviewReference      String
  legacyInventoryReference   String
  receiptQuiescenceReference String
  releasedAt                 DateTime
  integrityTag               String
  hold                       RecoveryHold           @relation(fields: [holdId], references: [id], onDelete: Restrict)
  evidence                   RecoveryReplayEvidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([evidenceId])
  @@index([sourceManifestSha256, releasedAt])
}
