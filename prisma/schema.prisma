  version                      Int
  state                        String                @default("PREPARING")
  planHash                     String                @unique
  candidateScoreSnapshotJson   String
  contentVersionIdsJson        String
  contentHashesJson            String
  evidenceSnapshotHash         String
  mappingVersionsJson          String                @default("[]")
  unknownTrafficPolicy         String                @default("ORIGINAL")
  aaProtocolJson               String
  realExperimentProtocolJson   String
  safetyPolicyVersion          String
  orchestrationProtocolVersion String                @default("autopilot-plan-v1")
  cutoverReceiptId             String?
  authorizedTransitionsJson    String
  approvalRecordJson           String?
  approvedBy                   String?
  approvedAt                   DateTime?
  mediumRiskAcknowledgedAt     DateTime?
  aaExperimentId               String?
  realExperimentId             String?
  resultSnapshotId             String?
  lockToken                    String?
  lockExpiresAt                DateTime?
  expiresAt                    DateTime
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  merchant                     Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product                      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  candidateScore               ProductCandidateScore @relation(fields: [candidateScoreId], references: [id], onDelete: Restrict)
  transitions                  AutopilotTransition[]
  notices                      MerchantNotice[]
