{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NeverListOrganizationBuckets",
      "Effect": "Deny",
      "Action": ["s3:ListAllMyBuckets"],
      "Resource": ["*"]
    },
    {
      "Sid": "ListDedicatedBackupBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::pagnetic-backups"]
    },
    {
      "Sid": "ReadWriteBackupAndReceiptPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::pagnetic-backups/pagnetic-backups/*"]
    },
    {
      "Sid": "NeverDeleteBackupData",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:DeleteBucket"],
      "Resource": ["arn:aws:s3:::pagnetic-backups", "arn:aws:s3:::pagnetic-backups/*"]
    }
  ]
}
