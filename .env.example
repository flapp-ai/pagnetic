SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://pagnetic.example.com
SCOPES=read_products,read_customer_events,read_orders,write_app_proxy,write_pixels
DATABASE_URL=file:./dev.sqlite

# Generate each with: openssl rand -base64 48
ASSIGNMENT_SECRET=
AUTOMATION_SECRET=
FIELD_ENCRYPTION_KEY=
# Retain every historical privacy scope/artifact key still referenced by requests.
# JSON array; maximum 7 previous keys. Escrow independently; never commit values.
PRIVACY_FIELD_ENCRYPTION_PREVIOUS_KEYS=[]
# Durable independent HMAC key; do not rotate when Shopify credentials rotate.
PRIVACY_LOOKUP_KEY=
# JSON array of every previous durable lookup key still referenced by retained data.
PRIVACY_LOOKUP_PREVIOUS_KEYS=[]
# Upgrade only: preserve the exact old Shopify API secret used by pre-versioned privacy rows.
PRIVACY_LEGACY_LOOKUP_KEY=
FUNNEL_HASH_SECRET=

# A durable mounted directory in the deployed container.
BACKUP_DESTINATION=/data/backups
BACKUP_LOCAL_KEEP=8
# Separate 32-byte base64 key, escrowed outside Fly with the database field key.
# Never reuse FIELD_ENCRYPTION_KEY. Required before encrypted backup jobs succeed.
BACKUP_ENCRYPTION_KEY=
# JSON array; maximum 7 prior base64 keys still referenced by backups, receipts or recovery audits.
BACKUP_ENCRYPTION_PREVIOUS_KEYS=[]
BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pagnetic-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
APP_RELEASE=

# HTTPS receiver for PagerDuty, Slack workflow, or another incident channel.
ALERT_WEBHOOK_URL=

# Founding public beta. Keep billing disabled until the owner sets the price.
PUBLIC_BETA_MAX_STORES=25
PUBLIC_FUNNEL_RETENTION_DAYS=90
APP_INSTANCE_COUNT=1
SHOPIFY_BILLING_ENABLED=false
PUBLIC_BETA_PLAN_NAME=Founding Beta
PUBLIC_BETA_MONTHLY_PRICE=49

# MVP v2 remains disabled until migration, targeted QA and release evidence pass.
PAGNETIC_V2_ENABLED=false
# Exact comma-separated internal .myshopify.com stores permitted to record a
# legacy-to-v2 migration receipt. This allowlist does not enable v2 serving.
PAGNETIC_V2_CUTOVER_SHOPS=
PAGNETIC_V2_SHADOW_ENABLED=false
PAGNETIC_V2_MODEL_ENABLED=false
PAGNETIC_V2_MODEL_PROVIDER=
PAGNETIC_V2_OFFER_PUBLISHABLE=false

# Shopify App Pricing authority (Partner API, read-only verification).
# The token requires Manage apps permission. Keep offer publication false until
# the Partner Dashboard plan, private no-charge test and welcome link are reviewed.
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_APP_HANDLE=
SHOPIFY_APP_PRICING_PLAN_HANDLE=
# Comma-separated development stores permitted to use Shopify's no-charge test.
# A $0 subscription from any other store is rejected.
SHOPIFY_APP_PRICING_NO_CHARGE_SHOPS=

# Public listing, legal, and support identity supplied by the product owner.
PUBLIC_APP_NAME=Pagnetic
PUBLIC_COMPANY_NAME="Flapp Bilişim A.Ş."
SUPPORT_EMAIL=support@flapp.ist
PRIVACY_CONTACT_EMAIL=privacy@flapp.ist
HOSTING_PROVIDER_NAME=
TERMS_EFFECTIVE_DATE=

# Runtime tuning
TRUST_PROXY_HEADERS=true
NODE_ENV=production
