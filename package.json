{
  "name": "adaptive-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "react-router build",
    "build:theme-runtime": "esbuild storefront/adaptive-panel.js --minify --target=es2018 --outfile=extensions/adaptive-panel/assets/adaptive-panel.js && esbuild storefront/adaptive-panel-v2.js --minify --target=es2018 --outfile=extensions/adaptive-panel/assets/adaptive-panel-v2.js && esbuild storefront/adaptive-vitals.js --minify --target=es2018 --outfile=extensions/adaptive-panel/assets/adaptive-vitals.js",
    "check": "pnpm test && pnpm typecheck && pnpm lint && pnpm build && pnpm shopify app build",
    "check:partner": "tsx scripts/partner-readiness-check.ts",
    "check:production": "tsx scripts/partner-readiness-check.ts --production",
    "predev": "pnpm build:theme-runtime",
    "dev": "shopify app dev",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --ignore-pattern extensions/adaptive-panel/assets/adaptive-panel.js --ignore-pattern extensions/adaptive-panel/assets/adaptive-panel-v2.js --ignore-pattern extensions/adaptive-panel/assets/adaptive-vitals.js --cache --cache-location ./node_modules/.cache/eslint .",
    "smoke:governance": "tsx scripts/milestone2-smoke.ts",
    "activate:measurement": "tsx scripts/milestone3-activate.ts",
    "smoke:measurement": "tsx scripts/milestone3-smoke.ts",
    "check:aa": "tsx scripts/milestone4-aa-check.ts",
    "activate:aa": "tsx scripts/milestone4-activate-aa.ts",
    "pretest": "pnpm build:theme-runtime",
    "test": "tsx --test tests/*.test.js tests/*.test.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "shopify": "shopify",
    "shopify:build": "shopify app build",
    "shopify:deploy": "shopify app deploy",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-api": "^14.0.1",
    "@shopify/shopify-app-react-router": "^2.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "isbot": "^5.1.31",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/cli": "^4.7.1",
    "@shopify/polaris-types": "^1.0.1",
    "@shopify/web-pixels-extension": "^2.18.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
